# Lab settings for run.sh. Copy, edit, and pass the file: ./run.sh my-lab.env
# Values below are placeholders: fill in your lab. Keep real lab files out of this public
# repository (internal addresses and IDs).
# No credentials go in this file: CLI_RC is sourced in place on CLI_SSH and never copied.

# Host where the OpenStack CLI runs, and the admin credentials file on it.
CLI_SSH=root@<cli-host>
CLI_RC=/root/admin.rc
REGION=<region>

# Volume type of the VMstore backend under test.
VOLUME_TYPE=<vmstore-volume-type>

# Host used for record and file checks: runs cinder-volume for the backend and mounts the
# type's share.
CINDER_SSH=root@<cinder-volume-host>
CINDER_VENV=/opt/pf9/pf9-cindervolume-base
CINDER_CONF_DIR=/opt/pf9/etc/pf9-cindervolume-base/conf.d

# Every cinder-volume host serving the backend, to check they agree on the cache settings
# (default: CINDER_SSH only).
CONFIG_SSH="root@<cinder-volume-host-1> root@<cinder-volume-host-2>"

# Small image (cirros, qcow2 or raw). The run uploads a private copy, <PREFIX>-image, so the
# cache entries it creates are its own.
IMAGE_ID=<cirros-image-id>
# Optional, multi-store Glance only: store for that copy (a store that is not Cinder tests
# the cache; see the runbook).
#IMAGE_STORE=<glance-store-id>
# Optional: where IMAGE_ID's data can be read when Glance cannot serve it to CLI_SSH
# (`openstack image save` fails with "checksum mismatch"). On PCD the image library keeps it
# on one host, for example root@<image-library-host>:/var/opt/imagelibrary/data/glance/<IMAGE_ID>.
# The run checks its SHA-512 against Glance's before uploading the copy.
#IMAGE_SRC=root@<host>:<path>

# Every object the run creates is named <PREFIX>-* (plus the cache volume Cinder names
# image-<id of the copy>). Cleanup deletes only those.
PREFIX=vme36
