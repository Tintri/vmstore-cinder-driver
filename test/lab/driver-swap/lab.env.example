# Settings for swap.sh. Any lab env file of the other suites works too; these are the
# variables swap.sh reads. Placeholders only: keep real lab files out of this public
# repository. No credentials: the tool reads and copies none.

# cinder-volume hosts to change (ssh targets, root), used when none are given as arguments.
SWAP_HOSTS="root@<cinder-volume-host> root@<other-cinder-volume-host>"

# PCD paths on the cinder-volume hosts.
CINDER_VENV=/opt/pf9/pf9-cindervolume-base
CINDER_CONF_DIR=/opt/pf9/etc/pf9-cindervolume-base/conf.d
CINDER_LOG=/var/log/pf9/cindervolume-base.log

# Config file `swap.sh option` edits when --file is not given. See the runbook before
# choosing (docs/runbooks/driver-swap.md, "Which file").
OPTION_FILE=

# Host directory /root/<PREFIX>-driver-swap keeps the backups: use the same PREFIX until
# the rollback.
PREFIX=lab
