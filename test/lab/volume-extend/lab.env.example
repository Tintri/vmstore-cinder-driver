# Lab settings for the volume-extend suite. Copy, edit, and pass the file: ./run.sh my-lab.env
# Values below are placeholders: fill in your lab. Keep real lab files out of this public
# repository (internal addresses and IDs). A full env file from another suite also works: the variable names are
# the same (set PREFIX to something unused).
# No credentials go in this file: CLI_RC is sourced in place on CLI_SSH and never copied.

# Host where the OpenStack CLI runs, and the admin credentials file on it.
CLI_SSH=root@<cli-host>
CLI_RC=/root/admin.rc
REGION=<region>
AZ=<availability-zone>

# The test VM boots on this compute host (*_ID is the Nova compute host name, on PCD the
# host ID). SRC_COMPUTE_SSH is used for `virsh domblkinfo` (the size the guest is given).
# Leave SRC_COMPUTE_SSH empty if there is no ssh to the compute host: the guest size
# checks are then skipped.
SRC_COMPUTE_SSH=root@<compute-host>
SRC_COMPUTE_ID=<nova-compute-host-name>

# Volume type backed by VMstore.
VOLUME_TYPE=<vmstore-volume-type>

# Host used for record and file checks: runs cinder-volume and mounts the type's share.
# Leave CINDER_SSH empty for an API-only run: E2, E3 and E4 SKIP, E1 checks Cinder and the
# guest size only.
CINDER_SSH=root@<cinder-volume-host>
CINDER_VENV=/opt/pf9/pf9-cindervolume-base
CINDER_CONF_DIR=/opt/pf9/etc/pf9-cindervolume-base/conf.d

# Hosts whose cinder-volume log is searched (every host serving VOLUME_TYPE, since any of
# them may handle a request). Default: CINDER_SSH. CINDER_LOG overrides the log path
# (default /var/log/pf9/cindervolume-base.log).
LOG_SSH="root@<cinder-volume-host> root@<other-cinder-volume-host>"

# Small bootable image (cirros), VM network, and the project of the CLI credentials
# (owns the private test flavor).
IMAGE_ID=<cirros-image-id>
NETWORK_ID=<vm-network-id>
PROJECT=<project-of-the-cli-credentials>
FLAVOR_RAM_MB=256

# Every object the run creates is named <PREFIX>-*; cleanup deletes only those.
PREFIX=vme10
