# Lab settings for the snapshot suite. Copy, edit, and pass the file: ./run.sh my-lab.env
# Values below are placeholders: fill in your lab. Keep real lab files out of this public
# repository (internal addresses and IDs). A full env file from test/lab/volume-migration also works: this suite
# reads only the variables below (set PREFIX to something unused).
# No credentials go in this file: CLI_RC is sourced in place on CLI_SSH, and VMstore calls
# use the cinder-volume service's own configuration on CINDER_SSH, read in place.

# Host where the OpenStack CLI runs, and the admin credentials file on it.
CLI_SSH=root@<cli-host>
CLI_RC=/root/admin.rc
REGION=<region>

# Volume type backed by VMstore.
VOLUME_TYPE=<vmstore-volume-type>

# Optional: a host running cinder-volume for VOLUME_TYPE. It runs snapshot_lab.py with the
# service's Python to read Cinder records and to call VMstore through the installed driver.
# Leave CINDER_SSH empty for an API-only run: S1, S2 and S4 SKIP, S3 checks Cinder only.
CINDER_SSH=root@<cinder-volume-host>
CINDER_VENV=/opt/pf9/pf9-cindervolume-base
CINDER_CONF_DIR=/opt/pf9/etc/pf9-cindervolume-base/conf.d

# Hosts whose cinder-volume log is searched for each snapshot: every host serving
# VOLUME_TYPE, since any of them may handle the delete. Default: CINDER_SSH.
# CINDER_LOG overrides the log path (default /var/log/pf9/cindervolume-base.log).
LOG_SSH="root@<cinder-volume-host> root@<other-cinder-volume-host>"

# Every object the run creates is named <PREFIX>-*; cleanup deletes only those.
PREFIX=vme34
