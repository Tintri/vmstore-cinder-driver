# Lab settings for the format-matrix suite. Copy, edit, and pass the file: ./run.sh my-lab.env
# Values below are placeholders: fill in your lab. Keep real lab files out of this public
# repository (internal addresses and IDs). The variable names are the same as in the other
# suites, so one env file per lab serves them all (set PREFIX to something unused).
# No credentials go in this file: CLI_RC is sourced in place on CLI_SSH and never copied.

# Host where the OpenStack CLI runs, and the admin credentials file on it.
CLI_SSH=root@<cli-host>
CLI_RC=/root/admin.rc
REGION=<region>
AZ=<availability-zone>

# VMs boot on SRC. *_ID is the Nova compute host name (on PCD the host ID). The *_SSH hosts
# are used for `virsh dumpxml` (the format libvirt opens); without them the libvirt column
# reads "unchecked".
SRC_COMPUTE_SSH=root@<src-compute-host>
SRC_COMPUTE_ID=<src-nova-compute-host-name>
# --two-host only: the VM is moved to DST and back.
DST_COMPUTE_SSH=root@<dst-compute-host>
DST_COMPUTE_ID=<dst-nova-compute-host-name>

# Volume type backed by VMstore, and (--two-host) the cinder-volume hosts serving it: the
# data volume is migrated from the one it lands on to the other.
VOLUME_TYPE=<vmstore-volume-type>
VOLUME_HOSTS="<src-cinder-volume-host> <dst-cinder-volume-host>"

# Required: a host running cinder-volume for VOLUME_TYPE. Reads the Cinder format record
# with the service's Python and the real file format with qemu-img (read-only).
CINDER_SSH=root@<cinder-volume-host>
CINDER_VENV=/opt/pf9/pf9-cindervolume-base
CINDER_CONF_DIR=/opt/pf9/etc/pf9-cindervolume-base/conf.d

# Every host serving VOLUME_TYPE: the report shows vmstore_qcow2_volumes and the driver
# version each one runs. CINDER_LOG overrides the log path
# (default /var/log/pf9/cindervolume-base.log).
LOG_SSH="root@<cinder-volume-host> root@<other-cinder-volume-host>"

# Small bootable image (cirros), VM network, and the project of the CLI credentials
# (owns the private test flavors).
IMAGE_ID=<cirros-image-id>
NETWORK_ID=<vm-network-id>
PROJECT=<project-name>
FLAVOR_RAM_MB=256

# Free-text release label for the report, for example "Aug P2" or "Dec".
PCD_RELEASE=

# Every object the run creates is named <PREFIX>-*; cleanup deletes only those.
PREFIX=fmt
