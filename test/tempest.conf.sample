# Sample Tempest Configuration for VMstore Driver Testing
# Place this in /opt/stack/tempest/etc/tempest.conf on DevStack

[DEFAULT]
# Enable debug logging for troubleshooting
debug = True
log_file = tempest.log
use_stderr = False

[auth]
# Use v3 identity API
use_dynamic_credentials = True
tempest_roles = Member

[identity]
uri_v3 = http://127.0.0.1/identity/v3
auth_version = v3
region = RegionOne

[volume]
# VMstore backend configuration
backend_names = vmstore_nfs
storage_protocol = NFS

# Volume size for tests (in GB)
volume_size = 1

# Number of retries
build_timeout = 300
build_interval = 1

# Volume types (adjust based on your cinder.conf)
# If you created a volume type called 'vmstore', set it here
# volume_type = vmstore

[volume-feature-enabled]
# Features your VMstore driver supports
backup = False                    # Set to True if backup is configured
snapshot = True                   # VMstore supports snapshots
clone = True                      # VMstore supports volume cloning
extend = False                    # Set based on your implementation
manage_volume = False             # Set to True if manage/unmanage implemented
manage_snapshot = False
multi_backend = False             # Set True if multiple backends configured

# Attach/detach features
attach_encrypted_volume = False
extend_attached_volume = False
extend_attached_encrypted_volume = False

[service_available]
# Services needed for Cinder testing
cinder = True
nova = True        # Required for volume attach tests
glance = True      # Required for bootable volume tests
neutron = True
swift = False      # Only if testing backups

[compute]
# For volume attach/detach tests
min_compute_nodes = 1
build_timeout = 300

[compute-feature-enabled]
# Required for volume attachment tests
attach_encrypted_volume = False
block_migration_for_live_migration = False
volume_multiattach = False        # VMstore doesn't support multiattach

[validation]
# For instance validation in scenario tests
image_ssh_user = cirros
run_validation = True
connect_method = floating

[scenario]
# Scenario test configuration
img_dir = /opt/stack/tempest/etc
img_file = cirros-0.5.2-x86_64-disk.img

