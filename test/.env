# VMstore Test Environment Configuration
# Copy this file to .env and customize for your local setup

# VMstore API Endpoint (WireMock container)
VMSTORE_REST_ADDRESS=localhost
VMSTORE_REST_PORT=8080
VMSTORE_REST_PROTOCOL=http

# VMstore Credentials (for testing)
VMSTORE_USER=admin
VMSTORE_PASSWORD=test_password

# NFS Server Configuration
NFS_HOST=localhost
NFS_SHARE_PATH=/nfs/cinder
NFS_MOUNT_OPTIONS=vers=3

# Test Volume Configuration
TEST_VOLUME_SIZE=1
TEST_VOLUME_NAME=test-volume

# Driver Configuration
VMSTORE_QCOW2_VOLUMES=False
VMSTORE_SPARSED_VOLUMES=True
