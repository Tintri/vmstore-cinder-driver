[MASTER]
# Pylint configuration for VMstore Cinder Driver

# Use multiple processes to speed up Pylint
jobs=4

# Pickle collected data for later comparisons
persistent=yes

[MESSAGES CONTROL]
# Disable specific warnings that are too noisy or not applicable
disable=
    # Too strict for initial development
    missing-docstring,
    too-few-public-methods,
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-instance-attributes,
    # Style preferences
    invalid-name,
    line-too-long,
    # OpenStack specific
    import-error,
    no-member,
    # Test related
    redefined-outer-name,
    unused-argument,
    protected-access

[REPORTS]
# Report format
output-format=colorized
reports=no
score=yes

[BASIC]
# Good variable names
good-names=i,j,k,ex,Run,_,id,LOG

# Regular expression for acceptable names
variable-rgx=[a-z_][a-z0-9_]{2,30}$
const-rgx=(([A-Z_][A-Z0-9_]*)|(__.*__))$

[FORMAT]
# Maximum line length
max-line-length=127

# Maximum number of lines in a module
max-module-lines=1000

# String used as indentation unit
indent-string='    '

[DESIGN]
# Maximum number of arguments for function / method
max-args=10

# Maximum number of attributes for a class
max-attributes=15

# Maximum number of boolean expressions in an if statement
max-bool-expr=5

# Maximum number of branch for function / method body
max-branches=15

# Maximum number of locals for function / method body
max-locals=20

# Maximum number of parents for a class
max-parents=7

# Maximum number of public methods for a class
max-public-methods=25

# Maximum number of return / yield for function / method body
max-returns=6

# Maximum number of statements in function / method body
max-statements=60

[SIMILARITIES]
# Minimum lines number of a similarity
min-similarity-lines=8

# Ignore imports when computing similarities
ignore-imports=yes
